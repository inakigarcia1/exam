{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // #794: direct typecheck resolves workspace packages through the same
    // "@exam/test-source" condition the Vitest runtime applies, so type
    // evidence matches the source the tests execute — never a stale dist
    // .d.ts. Production build keeps tsconfig.json (dist types are the
    // production type authority, guaranteed fresh by turbo ^build).
    "noEmit": true,
    "customConditions": ["@exam/test-source"]
  }
}
