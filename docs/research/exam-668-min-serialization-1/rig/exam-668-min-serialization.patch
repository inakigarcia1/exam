+// ── EXAM-668 RESEARCH SEAM (not for production merge) ─────────────────────
+//
+// Selects the Exam-authority lock mode for the deadline-decision reader class:
+//   update (default) — canonical #558/#560 mechanism: FOR UPDATE
+//   share            — #667 candidate mechanism: FOR SHARE (writer conflict
+//                      semantics identical; same-exam readers coexist)
+//   none             — counterfactual negative control: plain MVCC read (the
+//                      pre-#558 defect shape; must fail the writer-first tests)
+// Read per call so a single research tree serves all experiment arms.
+type Exam668LockMode = "update" | "share" | "none";
+
+function exam668LockMode(): Exam668LockMode {
+  const raw = process.env.EXAM_668_LOCK_MODE;
+  return raw === "share" || raw === "none" ? raw : "update";
+}
+
+async function exam668ReadExamAuthority(
+  examRepo: ExamRepository,
+  examId: string,
+): Promise<Exam | null> {
+  const mode = exam668LockMode();
+  if (mode === "none") {
+    return examRepo.findById(examId);
+  }
+  if (mode === "share") {
+    if (!examRepo.findByIdForShare) {
+      throw new Error(
+        "EXAM_668_LOCK_MODE=share requires an ExamRepository with findByIdForShare",
+      );
+    }
+    return examRepo.findByIdForShare(examId);
+  }
+  return examRepo.findByIdForUpdate(examId);
+}
